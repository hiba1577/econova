@startuml cas-utilisation
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #E3EFEA
  BorderColor #1F7A72
  ArrowColor #123B3A
}

title Vivora - Module 1 : Utilisateurs, partenariats et dons

actor "Visiteur" as V
actor "Utilisateur" as U
actor "Administrateur" as A

U --|> V
A --|> U

rectangle "Vivora" {
  usecase "S'inscrire\n(compte + profil d'accessibilité)" as UC_Inscrire
  usecase "S'authentifier" as UC_Auth
  usecase "Consulter les publicités actives" as UC_Pubs
  usecase "Consulter les partenaires" as UC_Partenaires

  usecase "Gérer son profil" as UC_Profil
  usecase "Modifier ses informations" as UC_ProfilInfos
  usecase "Changer son mot de passe" as UC_ProfilMdp
  usecase "Modifier son profil d'accessibilité" as UC_ProfilAcc
  usecase "Supprimer son compte" as UC_ProfilSup
  usecase "Faire un don" as UC_Don
  usecase "Consulter ses dons" as UC_MesDons

  usecase "Gérer les utilisateurs" as UC_GU
  usecase "Ajouter un utilisateur" as UC_GU_A
  usecase "Consulter les utilisateurs" as UC_GU_C
  usecase "Modifier un utilisateur" as UC_GU_M
  usecase "Supprimer un utilisateur" as UC_GU_S
  usecase "Bloquer / réactiver un compte" as UC_Bloquer

  usecase "Gérer les partenaires" as UC_GP
  usecase "Ajouter un partenaire" as UC_GP_A
  usecase "Consulter les partenaires (admin)" as UC_GP_C
  usecase "Modifier un partenaire" as UC_GP_M
  usecase "Supprimer un partenaire" as UC_GP_S

  usecase "Gérer les publicités" as UC_GPub
  usecase "Ajouter une publicité" as UC_GPub_A
  usecase "Consulter les publicités" as UC_GPub_C
  usecase "Modifier une publicité" as UC_GPub_M
  usecase "Supprimer une publicité" as UC_GPub_S

  usecase "Gérer les dons" as UC_GD
  usecase "Consulter les dons" as UC_GD_C
  usecase "Valider / refuser un don" as UC_GD_V
  usecase "Supprimer un don" as UC_GD_S

  usecase "Consulter le tableau de bord" as UC_Dash
}

V --> UC_Inscrire
V --> UC_Auth
V --> UC_Pubs
V --> UC_Partenaires

U --> UC_Profil
U --> UC_Don
U --> UC_MesDons

A --> UC_GU
A --> UC_GP
A --> UC_GPub
A --> UC_GD
A --> UC_Dash

UC_ProfilInfos --|> UC_Profil
UC_ProfilMdp --|> UC_Profil
UC_ProfilAcc --|> UC_Profil
UC_ProfilSup --|> UC_Profil

UC_GU_A --|> UC_GU
UC_GU_C --|> UC_GU
UC_GU_M --|> UC_GU
UC_GU_S --|> UC_GU
UC_Bloquer .> UC_GU_M : <<extend>>

UC_GP_A --|> UC_GP
UC_GP_C --|> UC_GP
UC_GP_M --|> UC_GP
UC_GP_S --|> UC_GP

UC_GPub_A --|> UC_GPub
UC_GPub_C --|> UC_GPub
UC_GPub_M --|> UC_GPub
UC_GPub_S --|> UC_GPub

UC_GD_C --|> UC_GD
UC_GD_V --|> UC_GD
UC_GD_S --|> UC_GD

UC_Profil ..> UC_Auth : <<include>>
UC_Don ..> UC_Auth : <<include>>
UC_MesDons ..> UC_Auth : <<include>>
UC_GU ..> UC_Auth : <<include>>
UC_GP ..> UC_Auth : <<include>>
UC_GPub ..> UC_Auth : <<include>>
UC_GD ..> UC_Auth : <<include>>
UC_Dash ..> UC_Auth : <<include>>

@enduml
